Screen { background: $background; color: $foreground; }
#masthead { height: 1; margin: 1 2 0 2; }
#brand { width: 1fr; text-style: bold; }
#edition { width: auto; color: $text-muted; }
#overview { height: 3; margin: 1 2 0 2; }
.metric { width: 1fr; height: 2; padding-right: 2; }
#subscription-metric { width: 2fr; }
.metric-label { height: 1; color: $text-muted; }
.metric-value { height: 1; text-overflow: ellipsis; text-wrap: nowrap; }
#status { color: $text-muted; }
#status.online { color: $success; }
#status.pending { color: $warning; }
.buttons { height: 1; }
Button { height: 1; min-height: 1; min-width: 8; border: none;
         padding: 0 1; margin-right: 1; background: $surface; color: $foreground; }
Button:hover { background: $panel-lighten-1; }
Button:focus { background: $accent; color: $background; text-style: bold; }
Button.-primary, Button.-success { background: $accent; color: $background; }
Button.-primary:focus, Button.-success:focus { text-style: bold underline; }
Button.-error { color: $error; }
Button:disabled { background: $background; color: $text-disabled; text-opacity: 100%; }
#controls { margin: 0 2 1 2; }
TabbedContent { height: 1fr; margin: 0 2; }
Tabs { height: 2; }
Tab { padding: 0 2; color: $text-muted; }
Tab.-active { color: $accent; text-style: bold; }
Underline > .underline--bar { color: $accent; background: $surface; }
ContentSwitcher { height: 1fr; }
TabPane { padding: 1 0 0 0; }
DataTable { height: 1fr; min-height: 3; background: $background; }
DataTable > .datatable--header { background: $surface; color: $text-muted; }
DataTable > .datatable--odd-row { background: $surface 35%; }
DataTable > .datatable--even-row { background: $background; }
DataTable > .datatable--cursor { background: $panel; color: $foreground; }
DataTable:focus > .datatable--cursor { background: #2d424b; color: #eff6f7;
                                        text-style: bold; }
.hint { height: 1; color: $text-muted; text-wrap: nowrap; text-overflow: ellipsis; }
.empty { height: 1fr; min-height: 3; content-align: center middle;
         color: $text-muted; text-align: center; }
.list-area { height: 1fr; }
#feedback { height: 1; margin: 1 2 0 2; }
#message { width: 1fr; height: 1; color: $text-muted;
           text-wrap: nowrap; text-overflow: ellipsis; }
#message.error { color: $error; }
#message.success { color: $success; }
#message.progress { color: $accent; }
#node-filters { height: 1; margin-bottom: 1; }
#node-filters Select { width: 1fr; margin-right: 2; }
#node-filters Input { width: 1fr; }
Input { background: $surface; border: none; padding: 0 1; }
Input:focus { background: $panel; tint: $accent 8%; }
Input.invalid { background: $error 15%; }
SelectCurrent { background: $surface; border: none; }
Select:focus SelectCurrent { background: $panel; tint: $accent 8%; }
#group-hint { height: 1; color: $text-muted; text-wrap: nowrap; text-overflow: ellipsis; }
#test-tools { height: 1; margin-top: 1; }
#test-label { width: 7; color: $text-muted; }
#test-url { width: 1fr; height: 1; }
#log-tools { height: 1; margin-bottom: 1; }
#log-hint { width: 1fr; }
#log-text { height: auto; color: $foreground; }
#log-scroll { height: 1fr; }
#log-scroll:focus { background: $surface 25%; }
Footer { background: $surface; padding: 0 2; }
Dialog { align: center middle; background: $background 85%; }
#dialog { width: 66; max-width: 95%; height: auto; max-height: 90%;
          padding: 1 2; border: round $accent; background: $background; }
.dialog-title { text-style: bold; margin-bottom: 1; }
#form-fields { height: auto; max-height: 50vh; }
.field-label { height: auto; color: $text-muted; }
#form-fields Input, #form-fields Select { margin-bottom: 1; }
#form-error { height: auto; max-height: 3; color: $error; margin: 1 0; }
#form-error.progress { color: $accent; }
#detail-scroll { height: auto; max-height: 50vh; margin-bottom: 1; }
Screen.compact #masthead { margin: 0 2; }
Screen.compact #overview { margin: 0 2; }
Screen.compact #controls { margin: 0 2; }
Screen.compact TabPane { padding: 0; }
Screen.compact #node-filters { margin: 0; }
Screen.compact #test-tools { margin: 0; }
Screen.compact #feedback { margin: 0 2; }
#form-details, #error-details { display: none; }
